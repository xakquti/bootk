<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-05-28--0006-meeting_participants" author="xakquti">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="meeting_participants"/>
            </not>
        </preConditions>

        <createTable tableName="meeting_participants">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="person_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_meetper_person" referencedTableName="person"
                referencedColumnNames="id"/>
            </column>
            <column name="meeting_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_meetper_meeting" referencedTableName="meeting"
                             referencedColumnNames="id"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>